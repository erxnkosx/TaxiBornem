---
// Enkel het Latijnse lettertype-subset en de gewichten die de site gebruikt
// (400–800). Scheelt een hoop overbodige fontbestanden.
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/inter/latin-800.css";
import "../styles/global.css";

import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
import WhatsAppButton from "../components/WhatsAppButton";
import CookieBanner from "../components/CookieBanner";
import { SITE, businessSchema } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Zet op false voor de bedank- en 404-pagina (geen navigatie/footer). */
  chrome?: boolean;
  noindex?: boolean;
  /** Extra schema.org-blokken (FAQ, broodkruimels, dienst …). */
  extraSchema?: object | object[];
  /** Welk menu-item actief staat; standaard het huidige pad. */
  navPath?: string;
  /** Afbeelding die mee moet met deze pagina (voorladen voor snellere LCP). */
  preloadImage?: string;
}

const { title, description, chrome = true, noindex = false, extraSchema, navPath, preloadImage } = Astro.props;

// De build zet pagina's neer als /diensten.html (zie astro.config.mjs), maar
// Cloudflare Pages bedient ze op /diensten. Hier maken we het pad weer schoon,
// zodat canonical, sitemap en de actieve link in de navbar hetzelfde zeggen.
const cleanPath =
  Astro.url.pathname
    .replace(/\/index\.html$/, "/")
    .replace(/\.html$/, "")
    .replace(/(.)\/$/, "$1") || "/";

const canonical = new URL(cleanPath, SITE).href;
const currentPath = cleanPath;
const ogImage = `${SITE}/og-image.jpg`;
const fullTitle = `${title} | Taxi Bornem`;

const schemas = [businessSchema, ...(extraSchema ? [extraSchema].flat() : [])];
const heroImage = preloadImage ?? (currentPath === "/" ? "/car.webp" : undefined);
const analyticsId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "").trim();
if (analyticsId && !/^G-[A-Z0-9]+$/.test(analyticsId)) {
  throw new Error("PUBLIC_GA_MEASUREMENT_ID moet een geldig G- meet-ID zijn.");
}
---

<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    {analyticsId && <meta name="ga-measurement-id" content={analyticsId} />}
    <script>
      import { initAnalytics } from "../lib/analytics";
      initAnalytics();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* De site is alleen voor een lichte weergave ontworpen. Dit vertelt de
        browser dat, zodat hij niet zelf dark mode forceert. */}
    <meta name="color-scheme" content="light" />
    {/* Vierkant icoon op basis van het logo, ook klein leesbaar (o.a. in Google). */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Taxi Bornem" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Witte Kia-taxi van Taxi Bornem" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#FFC107" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>

  <body class="min-h-screen bg-background font-[Inter,sans-serif] antialiased">
    {chrome && <Navbar client:idle currentPath={navPath ?? currentPath} />}
    <main>
      <slot />
    </main>
    {chrome && <Footer />}
    <WhatsAppButton />
    <CookieBanner client:idle />
  </body>
</html>
