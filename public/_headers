# ─────────────────────────────────────────────────────────────────────
#  Taxi Bornem — Cloudflare Pages headers
#  Beveiliging, caching en noindex voor het pages.dev-adres.
# ─────────────────────────────────────────────────────────────────────

# Het projectadres op pages.dev (en elke preview-deploy) niet laten
# indexeren: alleen www.taxibornem.be hoort in Google te staan.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Beveiligingsheaders op alle pagina's
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Astro geeft assets een vingerafdruk in de bestandsnaam (bv. index.Bx3k.js),
# dus die mogen een jaar in de cache. Wijzigt de inhoud, dan wijzigt de naam.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Afbeeldingen en fonts: ook lang cachen
/*.webp
  Cache-Control: public, max-age=31536000
/*.png
  Cache-Control: public, max-age=31536000
/*.jpg
  Cache-Control: public, max-age=31536000
/*.svg
  Cache-Control: public, max-age=31536000
/*.woff2
  Cache-Control: public, max-age=31536000
